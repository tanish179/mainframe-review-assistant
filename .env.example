# MainFrame Computers - Environment Configuration
# Copy this file to .env for local development

# Primary AI Provider: Google Gemini API (Recommended: 1,500 free requests/day)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Secondary/Backup AI Provider: OpenRouter API (50 free requests/day)
# Get a key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Local development port (Only used for local Express proxy if run manually)
PORT=4000
